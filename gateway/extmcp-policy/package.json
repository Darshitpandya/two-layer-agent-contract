{
  "name": "guidance-is-not-policy-extmcp-policy",
  "version": "1.0.0",
  "description": "ExtMCP request-phase policy processor: argument-sensitive MCP authorization",
  "main": "dist/policy.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/policy.js",
    "dev": "ts-node policy.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
